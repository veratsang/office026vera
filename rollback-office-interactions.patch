+@keyframes office-file-open { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
+/* The explicit class also allows an acceptance harness to simulate the OS query. */
+.office-motion-reduced .about-id-card,
+.office-motion-reduced .project-archive .about-cover-visual > img,
+.office-motion-reduced .research-index-cat { transform:none !important; transition:none !important; }
+.office-motion-reduced .office-note { transition:none !important; }
+.office-motion-reduced .office-note-003 { transform:rotate(-5deg) !important; }
+.office-motion-reduced .office-note-004 { transform:rotate(4deg) !important; }
+.office-motion-reduced .office-step-pending,.office-motion-reduced .office-step-visible,
+.office-motion-reduced .office-file > .page-masthead h1,
+.office-motion-reduced .office-file > .page-masthead > .page-description,
+.office-motion-reduced .office-file > :not(.about-detail-backline):not(.page-masthead):not(.page-rule):not(.page-footer):not(.lab-formula) { animation:none !important; opacity:1 !important; transform:none !important; }
+@media(prefers-reduced-motion:reduce) {
